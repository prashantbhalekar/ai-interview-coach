# Root-level environment defaults. Keep secrets out of git.

# =========================
# Frontend
# =========================
NEXT_PUBLIC_APP_BASE_PATH=/interview-coach
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# =========================
# Core backend
# =========================
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_interview_coach
JWT_SECRET=change_me
FRONTEND_URL=http://localhost:3000

# =========================
# Phase toggles
# Phase 1 defaults: Redis/Queue/Embeddings/RAG disabled
# =========================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6380
QUEUE_ENABLED=false
CACHE_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
EMBEDDINGS_ENABLED=false
RAG_ENABLED=false

# =========================
# AI provider
# =========================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# =========================
# AI behavior
# =========================
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RESUME_ANALYSIS_CACHE_TTL_MS=120000
AI_RESUME_ANALYSIS_CACHE_MAX_ENTRIES=200

# =========================
# Storage
# Phase 1 production should use: STORAGE_DRIVER=r2
# =========================
STORAGE_DRIVER=local
STORAGE_LOCAL_BASE_PATH=.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# =========================
# Worker (Phase 2 deployment)
# =========================
WORKER_CONCURRENCY=5
EMBEDDING_CHUNK_TARGET_CHARS=1200
EMBEDDING_CHUNK_OVERLAP_CHARS=120
