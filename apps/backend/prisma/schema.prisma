generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
  aiUsages     AiUsage[]
  interviewSessions InterviewSession[]

  @@index([email])
}

enum AiProvider {
  GEMINI
  OPENAI
  OLLAMA
}

enum AiUsageStatus {
  SUCCESS
  ERROR
}

enum ResumeProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewSessionStatus {
  ACTIVE
  COMPLETED
}

model Resume {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ResumeProcessingStatus @default(UPLOADED)
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  storageBucket String
  storageUrl    String
  failureReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
  @@index([status])
}

model AiUsage {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AiProvider
  model        String
  operation    String
  status       AiUsageStatus
  promptChars  Int
  responseChars Int?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([operation])
  @@index([createdAt])
}

model InterviewSession {
  id                   String                 @id @default(cuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  focusArea            String?
  status               InterviewSessionStatus @default(ACTIVE)
  currentQuestionIndex Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  questions            InterviewQuestion[]
  answers              InterviewAnswer[]
  evaluation           InterviewEvaluation?

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model InterviewQuestion {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order     Int
  text      String
  createdAt DateTime         @default(now())
  answers   InterviewAnswer[]

  @@unique([sessionId, order])
  @@index([sessionId])
}

model InterviewAnswer {
  id             String             @id @default(cuid())
  sessionId      String
  session        InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       InterviewQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order          Int
  answerText     String
  score          Int
  feedbackSummary String
  followUpQuestion String
  createdAt      DateTime           @default(now())

  @@unique([sessionId, order])
  @@index([sessionId])
}

model InterviewEvaluation {
  id           String           @id @default(cuid())
  sessionId    String           @unique
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore Int
  strengths    String[]
  improvements String[]
  followUpPlan String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
