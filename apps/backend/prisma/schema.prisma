generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
  aiUsages     AiUsage[]

  @@index([email])
}

enum AiProvider {
  GEMINI
  OPENAI
  OLLAMA
}

enum AiUsageStatus {
  SUCCESS
  ERROR
}

enum ResumeProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Resume {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ResumeProcessingStatus @default(UPLOADED)
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  storageBucket String
  storageUrl    String
  failureReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
  @@index([status])
}

model AiUsage {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AiProvider
  model        String
  operation    String
  status       AiUsageStatus
  promptChars  Int
  responseChars Int?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  errorMessage String?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([operation])
  @@index([createdAt])
}
